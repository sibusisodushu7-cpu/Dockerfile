FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Run (Using standard Ubuntu base instead of Alpine)
FROM eclipse-temurin:17-jre
WORKDIR /app
# This line safely copies whatever jar was built and renames it to app.jar
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
